<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Ecommerce.Mobile.ViewModels"
             xmlns:entities="clr-namespace:Ecommerce.Shared.Entities;assembly=Ecommerce.Shared"
             x:DataType="viewmodels:CategoriesViewModel"
             x:Class="Ecommerce.Mobile.Views.CategoriesPage"
             Title="Categorías">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20" RowSpacing="10">

        <!-- Sección para agregar categoría -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Entry Placeholder="Nombre de la categoría"
                   Text="{Binding NewCategoryName}"
                   MaxLength="100"
                   Grid.Column="0" />
            <Button Text="Agregar" 
                    Command="{Binding AddCategoryCommand}"
                    Grid.Column="1"
                    BackgroundColor="Green"
                    TextColor="White" />
            <Button Text="Recargar" Command="{Binding LoadCategoriesCommand}"
                    Grid.Column="2"
                    BackgroundColor="Purple"
                    TextColor="White" />
        </Grid>

        <!-- Mensaje de error -->
        <Label Grid.Row="1" 
               Text="{Binding ErrorMessage}" 
               TextColor="Red"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

        <!-- Lista de categorías -->
        <RefreshView Grid.Row="2" 
                     Command="{Binding LoadCategoriesCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Categories}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedCategory}">
                <CollectionView.EmptyView>
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="No hay categorías disponibles" FontSize="Medium" TextColor="Gray" />
                        <Button Text="Recargar" Command="{Binding LoadCategoriesCommand}" 
                                HorizontalOptions="Center" Margin="0,10,0,0" />
                    </StackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:Category">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="Editar"
                                               BackgroundColor="Orange"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriesViewModel}}, Path=EditCategoryCommand}" />
                                    <SwipeItem Text="Eliminar"
                                               BackgroundColor="Red"
                                               Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoriesViewModel}}, Path=DeleteCategoryCommand}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Grid Padding="10">
                                <Frame BorderColor="DarkGrey" CornerRadius="5" Padding="10">
                                    <StackLayout>
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="Medium" TextColor="Black"/>
                                    </StackLayout>
                                </Frame>
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Botones de acción para la categoría seleccionada -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10" 
              IsVisible="{Binding SelectedCategory, Converter={StaticResource IsNotNullConverter}}">
            <Button Text="Editar" 
                    Command="{Binding EditCategoryCommand}"
                    Grid.Column="0"
                    BackgroundColor="Orange"
                    TextColor="White" />
            <Button Text="Eliminar" 
                    Command="{Binding DeleteCategoryCommand}"
                    Grid.Column="1"
                    BackgroundColor="Red"
                    TextColor="White" />
        </Grid>
    </Grid>
</ContentPage>
