<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Ecommerce.Mobile.ViewModels"
             x:Class="Ecommerce.Mobile.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="LoginPage">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Correo electrónico" />
        <Entry x:Name="EmailEntry" Placeholder="ejemplo@correo.com" Keyboard="Email" Text="{Binding EmailEntry}"/>

        <Label Text="Contraseña" />
        <Entry x:Name="PasswordEntry" Placeholder="******" IsPassword="True" Text="{Binding PasswordEntry}" />

        <Button Text="Iniciar sesión" Command="{Binding LoginClickedCommand}" />

        <Label Text="{Binding ErrorMessage}"
       TextColor="Red"
       IsVisible="{Binding IsErrorVisible}" />


    </VerticalStackLayout>
</ContentPage>
